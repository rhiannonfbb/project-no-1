# =============================================================
# Environment Variables — copy this file to .env.local
# and fill in the real values. NEVER commit .env.local to git.
# =============================================================

# -------------------------------------------------------------
# Supabase (PROJ-1: User Authentication + all DB features)
# Get these from: Supabase Dashboard → Settings → API
# -------------------------------------------------------------

# Your Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anonymous (public) key (safe to expose to the browser)
# This key only allows operations that are permitted by RLS policies.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# -------------------------------------------------------------
# Supabase Auth configuration (set in Supabase Dashboard)
# These are not environment variables — they are settings to
# configure inside the Supabase Dashboard under Authentication.
# Documented here for reference.
#
# Dashboard → Authentication → URL Configuration:
#   Site URL:          http://localhost:3000  (dev)
#                      https://your-domain.com  (prod)
#   Redirect URLs:     http://localhost:3000/auth/callback
#                      https://your-domain.com/auth/callback
#
# Dashboard → Authentication → Email:
#   Enable email confirmations: ON
#   Secure email change:        ON
# -------------------------------------------------------------

# -------------------------------------------------------------
# Optional: DeepL API (PROJ-6: Language Switcher DE/EN)
# Get from: https://www.deepl.com/pro#developer
# This key is SERVER-SIDE ONLY — do not prefix with NEXT_PUBLIC_
# -------------------------------------------------------------
DEEPL_API_KEY=your-deepl-api-key-here
